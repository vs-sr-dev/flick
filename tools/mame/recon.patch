+//-------------------------------------------------
+//  recon instrumentation (local experiment, not for upstream)
+//  HS_CPI=<n>     cycles charged per instruction (default 6)
+//  HS_PROF=<file> per-second log + PC histogram dumped at exit
+//-------------------------------------------------
+
+namespace {
+
+struct hs_prof
+{
+	int cpi = 6;
+	FILE *f = nullptr;
+	std::vector<uint32_t> pc_hist;          // SDRAM PCs, halfword granularity
+	uint64_t other_pc[256] = {};            // non-SDRAM PCs by top byte
+	uint32_t api_game[256] = {}, api_other[256] = {}, api_sec[256] = {};
+	uint32_t irq_sec[64] = {};
+	uint64_t irq_total[64] = {};
+	uint64_t page_sec[256] = {};            // 64 KB SDRAM pages, this second
+	uint64_t insn_sec = 0, insn_total = 0, insn_low_sec = 0;
+	double next = 1.0;
+	// HS_IDLE="lo-hi,lo-hi" PC ranges counted as idle; HS_MARK="pc,pc" PCs counted per second
+	std::vector<std::pair<uint32_t, uint32_t>> idle;
+	std::vector<uint32_t> mark;
+	uint64_t idle_sec = 0;
+	uint32_t mark_sec[8] = {};
+	double cpi_at = -1; int cpi_next = 0;   // HS_CPI_AT="<seconds>:<cpi>" switches the CPI mid-run
+
+	void init()
+	{
+		if (const char *c = getenv("HS_CPI")) cpi = std::max(1, atoi(c));
+		if (const char *c = getenv("HS_CPI_AT")) { cpi_at = atof(c); if (const char *k = strchr(c, ':')) cpi_next = std::max(1, atoi(k + 1)); }
+		if (const char *s = getenv("HS_IDLE"))
+			for (const char *p = s; *p; )
+			{
+				char *e; uint32_t lo = strtoul(p, &e, 16); uint32_t hi = lo;
+				if (*e == '-') hi = strtoul(e + 1, &e, 16);
+				idle.emplace_back(lo, hi);
+				p = (*e == ',') ? e + 1 : e;
+			}
+		if (const char *s = getenv("HS_MARK"))
+			for (const char *p = s; *p && mark.size() < 8; )
+			{
+				char *e; mark.push_back(strtoul(p, &e, 16));
+				p = (*e == ',') ? e + 1 : e;
+			}
+		if (const char *p = getenv("HS_PROF"))
+		{
+			f = fopen(p, "w");
+			if (f) { pc_hist.assign(0x800000, 0); fprintf(f, "# HS_CPI=%d\n", cpi); }
+		}
+	}
+
+	void insn(uint32_t pc, uint32_t r3)
+	{
+		insn_sec++;
+		for (auto &r : idle) if (pc >= r.first && pc <= r.second) { idle_sec++; break; }
+		for (size_t i = 0; i < mark.size(); i++) if (pc == mark[i]) mark_sec[i]++;
+		if ((pc & 0x1f000000) == 0)
+		{
+			pc_hist[(pc & 0xffffff) >> 1]++;
+			page_sec[(pc >> 16) & 0xff]++;
+			if ((pc & 0xffffff) < 0x90000) insn_low_sec++;
+			if ((pc & 0xfffffc00) == 0xa0000800 || (pc & 0xfffffc00) == 0xa0000c00)
+			{
+				const uint32_t idx = ((pc & 0x7ff) - 0x000) >> 2;  // word index from 0xa0000800
+				if (idx < 256)
+				{
+					api_sec[idx]++;
+					if ((r3 & 0x1fffffff) >= 0x00090000) api_game[idx]++; else api_other[idx]++;
+				}
+			}
+		}
+		else
+			other_pc[pc >> 24]++;
+	}
+
+	void tick(double t)
+	{
+		if (cpi_at >= 0 && t >= cpi_at) { cpi = cpi_next; cpi_at = -1; fprintf(f, "# CPI -> %d at %.1f\n", cpi, t); }
+		if (t < next) return;
+		fprintf(f, "T %.0f insn %llu low %llu idle %llu mark", next, (unsigned long long)insn_sec, (unsigned long long)insn_low_sec, (unsigned long long)idle_sec);
+		for (size_t i = 0; i < mark.size(); i++) fprintf(f, " %u", mark_sec[i]);
+		fprintf(f, " irq");
+		idle_sec = 0; memset(mark_sec, 0, sizeof(mark_sec));
+		for (int i = 0; i < 64; i++) if (irq_sec[i]) fprintf(f, " %d:%u", i, irq_sec[i]);
+		fprintf(f, " api");
+		for (int i = 0; i < 256; i++) if (api_sec[i]) fprintf(f, " %03x:%u", 0x800 + i * 4, api_sec[i]);
+		fprintf(f, " pages");
+		for (int i = 0; i < 256; i++) if (page_sec[i] * 50 > insn_sec) fprintf(f, " %02x:%llu%%", i, (unsigned long long)(page_sec[i] * 100 / std::max<uint64_t>(insn_sec, 1)));
+		fprintf(f, "\n");
+		fflush(f);
+		insn_total += insn_sec;
+		insn_sec = insn_low_sec = 0;
+		memset(irq_sec, 0, sizeof(irq_sec)); memset(api_sec, 0, sizeof(api_sec)); memset(page_sec, 0, sizeof(page_sec));
+		next += 1.0;
+	}
+
+	~hs_prof()
+	{
+		if (!f) return;
+		fprintf(f, "# total insn %llu\n# api (word offset from a0000000: game-called / other-called)\n", (unsigned long long)insn_total);
+		for (int i = 0; i < 256; i++) if (api_game[i] || api_other[i]) fprintf(f, "API %08x %u %u\n", 0xa0000800 + i * 4, api_game[i], api_other[i]);
+		fprintf(f, "# irq totals\n");
+		for (int i = 0; i < 64; i++) if (irq_total[i]) fprintf(f, "IRQ %d %llu\n", i, (unsigned long long)irq_total[i]);
+		for (int i = 0; i < 256; i++) if (other_pc[i]) fprintf(f, "OTHERPC %02xxxxxxx %llu\n", i, (unsigned long long)other_pc[i]);
+		std::vector<std::pair<uint32_t, uint32_t>> top;
+		for (uint32_t i = 0; i < pc_hist.size(); i++) if (pc_hist[i]) top.emplace_back(pc_hist[i], 0xa0000000 | (i << 1));
+		std::sort(top.begin(), top.end(), std::greater<>());
+		for (size_t i = 0; i < top.size() && i < 400; i++) fprintf(f, "PC %08x %u\n", top[i].second, top[i].first);
+		fclose(f);
+	}
+};
+
+hs_prof s_prof;
+
+//-------------------------------------------------
+//  HS_TRACE=<file>[:N]  instruction trace for the first N instructions (default 50M),
+//  then the file is closed and MAME exits. Format (HyperScanEmu --trace writes the same):
+//    S <all regs>                     state before the first instruction
+//    <pc> <op> [reg=val ...]          one per instruction; op is 4 hex digits for a 16-bit
+//                                     instruction, else the fetched word; regs that changed
+//     R4 <addr> <val> / W1 ...        MMIO accesses made by the instruction above
+//    L <line> c=<cycles>              IRQ line asserted (before the next instruction line)
+//    I <line> c=<cycles> / X <cause>  interrupt / other exception taken; printed before the
+//                                     line of the instruction it happened in (the handler's
+//                                     first instruction for I, which also shows the cr changes)
+//    E n=<insns> c=<cycles> <regs>    state after the last instruction
+//-------------------------------------------------
+
+struct hs_trace
+{
+	FILE *f = nullptr;
+	uint64_t n = 0, limit = 50000000;
+	uint32_t snap[0x20 + 0x20 + 3 + 2];
+	std::string acc;                        // MMIO accesses of the current instruction
+
+	void init()
+	{
+		const char *p = getenv("HS_TRACE");
+		if (!p) return;
+		std::string path(p);
+		size_t c = path.rfind(':');
+		if (c != std::string::npos && c > 1)   // keep "D:/..." intact
+		{
+			limit = strtoull(path.c_str() + c + 1, nullptr, 0);
+			path.resize(c);
+		}
+		f = fopen(path.c_str(), "w");
+		if (f) { setvbuf(f, nullptr, _IOFBF, 1 << 22); fprintf(f, "# hstrace 1\n"); }
+	}
+
+	static bool mmio(offs_t a)
+	{
+		a &= 0x1fffffff;
+		return a >= 0x08000000 && a < 0x10000000
+			&& !(a >= 0x0a000000 && a < 0x0a004000)    // internal SRAM
+			&& !(a >= 0x0b000000 && a < 0x0b008000);   // internal ROM
+	}
+
+	void access(char rw, int size, offs_t a, uint32_t v)
+	{
+		char b[40];
+		snprintf(b, sizeof(b), " %c%d %08x %0*x\n", rw, size, a, size * 2, v);
+		acc += b;
+	}
+
+	static void regs(FILE *f, const uint32_t *r)
+	{
+		for (int i = 0; i < 0x20; i++) fprintf(f, " r%d=%08x", i, r[i]);
+		for (int i = 0; i < 0x20; i++) fprintf(f, " cr%d=%08x", i, r[0x20 + i]);
+		for (int i = 0; i < 3; i++) fprintf(f, " sr%d=%08x", i, r[0x40 + i]);
+		fprintf(f, " ceh=%08x cel=%08x", r[0x43], r[0x44]);
+	}
+
+	void gather(uint32_t *r, const uint32_t *gpr, const uint32_t *cr, const uint32_t *sr, const uint32_t *ce)
+	{
+		memcpy(r, gpr, 0x20 * 4); memcpy(r + 0x20, cr, 0x20 * 4); memcpy(r + 0x40, sr, 3 * 4); memcpy(r + 0x43, ce, 2 * 4);
+	}
+
+	void begin(uint32_t pc, const uint32_t *gpr, const uint32_t *cr, const uint32_t *sr, const uint32_t *ce)
+	{
+		gather(snap, gpr, cr, sr, ce);
+		if (n == 0) { fprintf(f, "S pc=%08x", pc); regs(f, snap); fprintf(f, "\n"); }
+	}
+
+	// returns true when the limit is reached and the trace has been closed
+	bool end(uint32_t pc, uint32_t op, bool op16, uint64_t cycles, const uint32_t *gpr, const uint32_t *cr, const uint32_t *sr, const uint32_t *ce)
+	{
+		static const char *const ce_name[2] = { "ceh", "cel" };
+		uint32_t now[sizeof(snap) / 4];
+		gather(now, gpr, cr, sr, ce);
+		if (op16) fprintf(f, "%08x %04x", pc, op & 0xffff); else fprintf(f, "%08x %08x", pc, op);
+		for (int i = 0; i < int(sizeof(snap) / 4); i++)
+			if (now[i] != snap[i])
+			{
+				if (i < 0x20) fprintf(f, " r%d=%08x", i, now[i]);
+				else if (i < 0x40) fprintf(f, " cr%d=%08x", i - 0x20, now[i]);
+				else if (i < 0x43) fprintf(f, " sr%d=%08x", i - 0x40, now[i]);
+				else fprintf(f, " %s=%08x", ce_name[i - 0x43], now[i]);
+			}
+		fprintf(f, "\n");
+		if (!acc.empty()) { fputs(acc.c_str(), f); acc.clear(); }
+		if (++n < limit) return false;
+		fprintf(f, "E n=%llu c=%llu pc=%08x", (unsigned long long)n, (unsigned long long)cycles, pc);
+		regs(f, now);
+		fprintf(f, "\n");
+		fclose(f);
+		f = nullptr;
+		return true;
+	}
+};
+
+hs_trace s_trace;
+
+} // anonymous namespace
