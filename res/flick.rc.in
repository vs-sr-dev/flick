// flick.exe's resources, configured by CMake: the icon (Explorer, the taskbar and, through
// SDL, the window) and the version shown in the file's properties
1 ICON "@FLICK_ICON@"

1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Samuele Voltan"
      VALUE "FileDescription", "Flick - Mattel HyperScan emulator"
      VALUE "FileVersion", "@FLICK_VERSION@"
      VALUE "InternalName", "flick"
      VALUE "LegalCopyright", "Copyright (c) 2026 Samuele Voltan. MIT License."
      VALUE "OriginalFilename", "flick.exe"
      VALUE "ProductName", "Flick"
      VALUE "ProductVersion", "@FLICK_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
